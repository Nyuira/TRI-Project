OTEBOOK 08: FAIRNESS & ROBUSTNESS\")\n","print(\"=\"*50)\n","print(\"Environment configured for model auditing\")"]},{"cell_type":"code","source":["#Fairness Analysis: Verified Model Loading and Subgroup Parsing\n","\n","import joblib\n","import requests\n","from io import BytesIO\n","\n","print(\"=\"*50)\n","print(\"NOTEBOOK 08: FAIRNESS & ROBUSTNESS AUDIT\")\n","print(\"=\"*50)\n","\n","#Modelling: Loading data from primary GitHub branch\n","print(\"\\nLoading datasets...\")\n","train_url = \"https://github.com/Nyuira/TRI-Project/raw/main/teacher_readiness_train.csv\"\n","test_url = \"https://github.com/Nyuira/TRI-Project/raw/main/teacher_readiness_test.csv\"\n","\n","df_train = pd.read_csv(train_url)\n","df_test = pd.read_csv(test_url)\n","\n","#Modelling: Loading the final model from the VERIFIED GitHub path\n","model_url = \"https://github.com/Nyuira/TRI-Project/raw/main/outputs/notebook_07_MODEL_INTERPRETATION/models/07_final_stacking_model.pkl\"\n","\n","try:\n","    response = requests.get(model_url)\n","    response.raise_for_status()\n","    final_model = joblib.load(BytesIO(response.content))\n","    print(\"✓ Final stacking model loaded successfully from GitHub\")\n","except Exception as e:\n","    print(f\"Error loading model: {e}\")\n","\n","#Modelling: Robust Subgroup Parser for Kenyan School Context\n","def parse_school_id_final(school_id):\n","    sid = str(school_id).strip()\n","    parts = sid.split('_')\n","\n","    #Logic to handle the observed underscore structure\n","    if 'Public' in sid:\n","        school_type = 'Public'\n","        #If format is Public_Level_Location_ID\n","        school_level = parts[1] if len(parts) > 1 else 'Unknown'\n","        location = parts[2] if len(parts) > 2 else 'Unknown'\n","    elif 'Private' in sid:\n","        school_type = 'Private'\n","        school_level = 'Private'\n","        location = parts[1] if len(parts) > 1 else 'Unknown'\n","    else:\n","        school_type, school_level, location = 'Other', 'Other', 'Other'\n","\n","    return pd.Series({'school_type': school_type, 'school_level': school_level, 'location': location})\n","\n","#Visualizing the application of corrected labels\n","#Removing old subgroup columns if they exist before re-applying\n","cols_to_drop = ['school_type', 'school_level', 'location']\n","df_test = df_test.drop(columns=[c for c in cols_to_drop if c in df_test.columns])\n","\n","subgroups_test = df_test['school_id'].apply(parse_school_id_final)\n","df_test = pd.concat([df_test, subgroups_test], axis=1)\n","\n","print(\"\\nREFINED SUBGROUP DISTRIBUTIONS (TEST SET):\")\n","print(\"-\" * 40)\n","print(f\"School Types: {df_test['school_type'].value_counts().to_dict()}\")\n","print(f\"Locations:    {df_test['location'].value_counts().to_dict()}\")\n","\n","#Modelling: Feature preparation\n","excluded_vars = [\n","    'TRI_scaled', 'items_composite', 'overall_readiness',\n","    'Digital', 'Pedagogical', 'Resource', 'training_quality_mean',\n","    'school_id', 'school_type', 'school_level', 'location'\n","]\n","\n","feature_names = [col for col in df_train.columns if col not in excluded_vars]\n","X_test = df_test[feature_names]\n","y_test = df_test['TRI_scaled']\n","\n","print(f\"\\n✓ Features prepared: {len(feature_names)} predictors\")\n","print(f\"✓ Audit sample size: {len(X_test)} teachers\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"x4dH-cZ46LTk","executionInfo":{"status":"ok","timestamp":1773843897193,"user_tz":-180,"elapsed":3288,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"ecd4eaff-9fc5-403b-bea7-54e2a525c56f"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["==================================================\n","NOTEBOOK 08: FAIRNESS & ROBUSTNESS AUDIT\n","==================================================\n","\n","Loading datasets...\n","✓ Final stacking model loaded successfully from GitHub\n","\n","REFINED SUBGROUP DISTRIBUTIONS (TES