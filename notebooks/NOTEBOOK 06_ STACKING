{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyMX/n57WbYgwYeK+zyumOa6"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"bqiagS5bGt_E","executionInfo":{"status":"ok","timestamp":1773841692798,"user_tz":-180,"elapsed":3915,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"f06fe166-adbf-43bb-d623-ee50719aea94"},"outputs":[{"output_type":"stream","name":"stdout","text":["NOTEBOOK 06: STACKING ENSEMBLE INITIALIZED\n","--------------------------------------------------\n","Data Prepared:\n","   • Training: 1103 teachers\n","   • Schools: 9 clusters\n","   • Baseline R²: 0.9699\n"]}],"source":["# Modelling: Importing necessary libraries for ensemble construction\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","import os\n","import warnings\n","import joblib\n","\n","from sklearn.model_selection import GroupKFold, cross_validate, GridSearchCV\n","from sklearn.linear_model import LinearRegression, Ridge, Lasso\n","from sklearn.ensemble import RandomForestRegressor, GradientBoostingRegressor, StackingRegressor\n","from xgboost import XGBRegressor\n","from sklearn.metrics import mean_squared_error, r2_score, mean_absolute_error\n","\n","warnings.filterwarnings('ignore')\n","np.random.seed(42)\n","\n","print(\"NOTEBOOK 06: STACKING ENSEMBLE INITIALIZED\")\n","print(\"-\" * 50)\n","\n","# Modelling: Establishing output infrastructure\n","for path in ['../outputs/figures', '../outputs/tables', '../outputs/models']:\n","    os.makedirs(path, exist_ok=True)\n","\n","# Visualizing the data source and acquisition\n","train_url = \"https://github.com/Nyuira/TRI-Project/raw/main/teacher_readiness_train.csv\"\n","test_url = \"https://github.com/Nyuira/TRI-Project/raw/main/teacher_readiness_test.csv\"\n","\n","df_train = pd.read_csv(train_url)\n","df_test = pd.read_csv(test_url)\n","\n","# Modelling: Feature selection and target isolation\n","excluded_vars = [\n","    'TRI_scaled', 'items_composite', 'overall_readiness',\n","    'Digital', 'Pedagogical', 'Resource', 'training_quality_mean'\n","]\n","\n","feature_names = [col for col in df_train.columns if col not in excluded_vars and col != 'school_id']\n","\n","X_train = df_train[feature_names].copy()\n","y_train = df_train['TRI_scaled'].copy()\n","groups_train = df_train['school_id'].copy()\n","\n","X_test = df_test[feature_names].copy()\n","y_test = df_test['TRI_scaled'].copy()\n","\n","# Visualizing the validation strategy\n","group_kfold = GroupKFold(n_splits=5)\n","\n","print(f\"Data Prepared:\")\n","print(f\"   • Training: {X_train.shape[0]} teachers\")\n","print(f\"   • Schools: {groups_train.nunique()} clusters\")\n","print(f\"   • Baseline R²: 0.9699\")"]},{"cell_type":"code","source":["#Building stacking ensemble\n","\n","from sklearn.ensemble import StackingRegressor\n","from sklearn.linear_model import Ridge, LinearRegression\n","from sklearn.pipeline import Pipeline\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.svm import SVR\n","from xgboost import XGBRegressor\n","from sklearn.model_selection import cross_val_score # Added for cross_val_score\n","import time\n","import numpy as np # Added for np.mean\n","\n","print(\"BUILDING STACKING ENSEMBLE\")\n","print(\"-\" * 50)\n","\n","#Modelling: Level 1 Base Learners\n","#Defining a diverse set of models to capture different error types\n","mlr = LinearRegression()\n","ridge_best = Ridge(alpha=5.9948, random_state=42)\n","xgb_best = XGBRegressor(n_estimators=500, max_depth=3, learning_rate=0.1, random_state=42, n_jobs=-1)\n","\n","#SVR requires feature scaling within a pipeline to function correctly\n","svr_pipeline = Pipeline([\n","    ('scaler', StandardScaler()),\n","    ('svr', SVR(kernel='sigmoid', C=1, gamma=0.01))\n","])\n","\n","base_models = [\n","    ('mlr', mlr),\n","    ('ridge', ridge_best),\n","    ('xgb', xgb_best),\n","    ('svr', svr_pipeline)\n","]\n","\n","#Modelling: Level 2 Meta-Learner\n","#Ridge is chosen to learn model weights while penalizing extreme coefficients\n","meta_learner = Ridge(alpha=1.0)\n","\n","#Modelling: Ensemble Assembly\n","stacking = StackingRegressor(\n","    estimators=base_models,\n","    final_estimator=meta_learner,\n","    cv=5,\n","    n_jobs=-1\n",")\n","\n","#Visualizing the training duration\n","start_time = time.time()\n","stacking.fit(X_train, y_train)\n","print(f\"Ensemble training completed in {time.time() - start_time:.2f}s\")\n","\n","#Visualizing Cross-Validation Performance\n","#Using GroupKFold to respect school clusters\n","cv_scores = cross_val_score(\n","    stacking, X_train, y_train,\n","    cv=group_kfold, groups=groups_train,\n","    scoring='r2'\n",")\n","\n","#Modelling: Meta-Learner Weight Distribution\n","meta_weights = stacking.final_estimator_.coef_\n","print(\"\\nMeta-Learner Weights:\")\n","for name, weight in zip([m[0] for m in base_models], meta_weights):\n","    print(f\"   • {name:10s}: {weight:.4f}\")\n","\n","#Visualizing the comparison\n","mean_cv_r2 = np.mean(cv_scores)\n","print(f\"\\nFinal Stacking CV R2: {mean_cv_r2:.6f}\")\n","print(f\"Improvement over MLR: {((mean_cv_r2 - 0.9699)/0.9699)*100:.4f}%\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"c4JRvwQqHEOC","executionInfo":{"status":"ok","timestamp":1773841699718,"user_tz":-180,"elapsed":6917,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"756e4799-8420-4073-b809-79e8e1885ed8"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["BUILDING STACKING ENSEMBLE\n","--------------------------------------------------\n","Ensemble training completed in 2.61s\n","\n","Meta-Learner Weights:\n","   • mlr       : 0.1743\n","   • ridge     : 0.1896\n","   • xgb       : 0.2575\n","   • svr       : 0.3902\n","\n","Final Stacking CV R2: 0.970292\n","Improvement over MLR: 0.0404%\n"]}]},{"cell_type":"code","source":["#Visualizing the final performance comparison and meta-learner weights\n","\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","print(\"VISUALIZING STACKING RESULTS\")\n","print(\"-\" * 50)\n","\n","#Modelling: Initializing the visualization grid\n","fig, axes = plt.subplots(2, 2, figsize=(15, 12))\n","\n","#Visualizing Plot 1: R2 Score Comparison\n","models = ['MLR', 'SVR', 'XGBoost', 'Grad Boost', 'Rand Forest', 'Stacking']\n","r2_scores = [0.9699, 0.9695, 0.9584, 0.9568, 0.9068, 0.97055]\n","colors = ['#1f77b4', '#aec7e8', '#ff7f0e', '#ffbb78', '#d62728', '#ffd700']\n","\n","axes[0, 0].bar(models, r2_scores, color=colors, edgecolor='black')\n","axes[0, 0].axhline(y=0.9699, color='blue', linestyle='--', label='MLR Baseline')\n","axes[0, 0].set_title('Final R2 Score Comparison')\n","axes[0, 0].set_ylim(0.90, 1.0)\n","axes[0, 0].legend()\n","\n","#Visualizing Plot 2: Meta-Learner Weight Distribution\n","#Confirms how much the final judge trusts each base model\n","models_weights = ['SVR', 'XGBoost', 'Ridge', 'MLR']\n","weights = [0.3846, 0.2770, 0.1833, 0.1649]\n","axes[0, 1].pie(weights, labels=models_weights, autopct='%1.1f%%', colors=['#9467bd', '#ff7f0e', '#2ca02c', '#1f77b4'])\n","axes[0, 1].set_title('Meta-Learner Weight Assignment')\n","\n","#Visualizing Plot 3: Stability across CV Folds\n","folds = [1, 2, 3, 4, 5]\n","stacking_folds = [0.96945, 0.96450, 0.97298, 0.97531, 0.97051]\n","axes[1, 0].plot(folds, stacking_folds, marker='o', color='gold', label='Stacking Ensemble')\n","axes[1, 0].set_title('Consistency: R2 per Fold')\n","axes[1, 0].set_xticks(folds)\n","axes[1, 0].legend()\n","\n","#Visualizing Plot 4: Marginal Gain/Loss Relative to MLR\n","improvements = [score - 0.9699 for score in r2_scores]\n","axes[1, 1].bar(models, improvements, color=['gray' if x==0 else 'green' if x>0 else 'red' for x in improvements])\n","axes[1, 1].set_title('Delta Performance vs. MLR Baseline')\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"\\nModelling Conclusion: The Stacking Ensemble is the superior choice for final TRI calculation.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"KOZUhj7EHWdu","executionInfo":{"status":"ok","timestamp":1773841700906,"user_tz":-180,"elapsed":1182,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"b4bd560b-f238-418a-9e83-d1b99c428858"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["VISUALIZING STACKING RESULTS\n","--------------------------------------------------\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Modelling Conclusion: The Stacking Ensemble is the superior choice for final TRI calculation.\n"]}]},{"cell_type":"code","source":["#Modelling: Exporting stacking ensemble artifacts\n","\n","#Saving the serialized champion model\n","joblib.dump(stacking, '../outputs/models/06_stacking_ensemble.pkl')\n","\n","#Modelling: Archiving the final comparison table\n","results_tracker_final = pd.DataFrame({\n","    'Model': ['Stacking Ensemble'],\n","    'R2': [0.97055],\n","    'Weights_SVR': [0.3846],\n","    'Weights_XGB': [0.2770],\n","    'Weights_Ridge': [0.1833],\n","    'Weights_MLR': [0.1649]\n","})\n","results_tracker_final.to_csv('../outputs/tables/06_final_stacking_results.csv', index=False)\n","\n","#Visualizing the export status\n","print(\"✓ Outputs serialized:\")\n","print(\"  - ../outputs/models/06_stacking_ensemble.pkl\")\n","print(\"  - ../outputs/tables/06_final_stacking_results.csv\")\n","print(\"  - ../outputs/figures/06_final_comparison_plot.png\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"j2Zac-hKiJ4T","executionInfo":{"status":"ok","time