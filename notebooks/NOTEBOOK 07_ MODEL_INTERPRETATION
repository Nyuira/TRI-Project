.0","_view_name":"StyleView","description_width":""}}}}},"cells":[{"cell_type":"code","execution_count":1,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Lo-MJRfcISVe","executionInfo":{"status":"ok","timestamp":1773843275937,"user_tz":-180,"elapsed":3347,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"ab189eec-ff4c-4622-b572-aaf3911f0ae6"},"outputs":[{"output_type":"stream","name":"stdout","text":["==================================================\n","NOTEBOOK 07: FINAL EVALUATION\n","==================================================\n","\n","FINAL TRAINING SET:\n","   * Teachers: 1,103\n","   * Features: 19\n","\n","TEST SET (UNSEEN):\n","   * Teachers: 97\n","\n","Note: Test data has been in quarantine until NOW!\n"]}],"source":["#Final Evaluation Setup: Data Matrix Preparation\n","\n","#Modelling: Data manipulation and numerical operations\n","import pandas as pd\n","import numpy as np\n","\n","#Visualizing: Plotting and statistical graphics\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","#Modelling: Core algorithms for the stacking framework\n","from sklearn.linear_model import LinearRegression, Ridge\n","from xgboost import XGBRegressor\n","from sklearn.svm import SVR\n","from sklearn.ensemble import StackingRegressor\n","from sklearn.preprocessing import StandardScaler\n","from sklearn.pipeline import Pipeline\n","\n","#Modelling: Performance metrics for regression validation\n","from sklearn.metrics import mean_squared_error, r2_score, mean_absolute_error\n","from sklearn.metrics import mean_absolute_percentage_error\n","\n","#Modelling: Persistence and environment management\n","import joblib\n","import os\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n","#Modelling: Ensuring reproducibility of results\n","np.random.seed(42)\n","\n","print(\"=\"*50)\n","print(\"NOTEBOOK 07: FINAL EVALUATION\")\n","print(\"=\"*50)\n","\n","#Visualizing: Data acquisition from primary repository\n","train_url = \"https://github.com/Nyuira/TRI-Project/raw/main/teacher_readiness_train.csv\"\n","test_url = \"https://github.com/Nyuira/TRI-Project/raw/main/teacher_readiness_test.csv\"\n","\n","df_train = pd.read_csv(train_url)\n","df_test = pd.read_csv(test_url)\n","\n","#Modelling: Feature selection and target isolation\n","excluded_vars = [\n","    'TRI_scaled', 'items_composite', 'overall_readiness',\n","    'Digital', 'Pedagogical', 'Resource', 'training_quality_mean'\n","]\n","\n","feature_names = [col for col in df_train.columns if col not in excluded_vars and col != 'school_id']\n","\n","#Modelling: Final training on complete dataset\n","X_train_final = df_train[feature_names].copy()\n","y_train_final = df_train['TRI_scaled'].copy()\n","\n","#Modelling: Isolating the Unseen Test Data\n","X_test = df_test[feature_names].copy()\n","y_test = df_test['TRI_scaled'].copy()\n","\n","print(f\"\\nFINAL TRAINING SET:\")\n","print(f\"   * Teachers: {X_train_final.shape[0]:,}\")\n","print(f\"   * Features: {X_train_final.shape[1]}\")\n","\n","print(f\"\\nTEST SET (UNSEEN):\")\n","print(f\"   * Teachers: {X_test.shape[0]}\")\n","print(f\"\\nNote: Test data has been in quarantine until NOW!\")"]},{"cell_type":"code","source":["#Final Stacking Model Evaluation and Prediction\n","\n","print(\"\\n\" + \"=\"*50)\n","print(\"BUILDING FINAL STACKING MODEL\")\n","print(\"=\"*50)\n","\n","#Modelling: Defining Level 1 Base Models\n","print(\"\\nLevel 1: Base Models\")\n","\n","mlr = LinearRegression()\n","ridge = Ridge(alpha=5.9948, random_state=42)\n","xgb = XGBRegressor(\n","    n_estimators=500, max_depth=3, learning_rate=0.1,\n","    subsample=0.7, colsample_bytree=1.0, random_state=42, n_jobs=-1\n",")\n","\n","svr_pipeline = Pipeline([\n","    ('scaler', StandardScaler()),\n","    ('svr', SVR(kernel='sigmoid', C=1, gamma=0.01))\n","])\n","\n","base_models = [('mlr', mlr), ('ridge', ridge), ('xgb', xgb), ('svr', svr_pipeline)]\n","\n","#Modelling: Level 2 Meta-Learner\n","meta_learner = Ridge(alpha=1.0)\n","\n","#Modelling: Final Training on all available training data\n","final_stacking = StackingRegressor(estimators=base_models, final_estimator=meta_learner, cv=5, n_jobs=-1)\n","final_stacking.fit(X_train_final, y_train_final)\n","print(\"Final model trained on full training set\")\n","\n","print(\"\\n\" + \"=\"*50)\n","print(\"TEST SET EVALUATION\")\n","print(\"=\"*50)\n","\n","#Modelling: Generating predictions on unseen data\n","y_pred = final_stacking.predict(X_test)\n","\n","#Modelling: Calculating definitive performance metrics\n","test_r2 = r2_score(y_test, y_pred)\n","test_rmse = np.sqrt(mean_squared_error(y_test, y_pred))\n","test_mae = mean_absolute_error(y_test, y_pred)\n","\n","print(f\"\\nFinal Test Performance:\")\n","print(f\"   * R2:   {test_r2:.6f}\")\n","print(f\"   * RMSE: {test_rmse:.4f}\")\n","print(f\"   * MAE:  {test_mae:.4f}\")\n","\n","#Visualizing: Performance Plots\n","residuals = y_test - y_pred\n","fig, axes = plt.subplots(1, 2, figsize=(15, 6))\n","\n","#Plot 1: Actual vs Predicted\n","axes[0].scatter(y_test, y_pred, alpha=0.7, edgecolors='black')\n","axes[0].plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'r--')\n","axes[0].set_title(f'Actual vs Predicted (Test Set)\\nR2 = {test_r2:.4f}')\n","\n","#Plot 2: Residual Histogram\n","axes[1].hist(residuals, bins=20, edgecolor='black', alpha=0.7)\n","axes[1].set_title('Distribution of Prediction Errors')\n","\n","plt.tight_layout()\n","plt.show()\n","\n","#Comparison with Baseline MLR on Test Set\n","mlr_final = LinearRegression()\n","mlr_final.fit(X_train_final, y_train_final)\n","mlr_test_pred = mlr_final.predict(X_test)\n","mlr_test_r2 = r2_score(y_test, mlr_test_pred)\n","\n","print(f\"\\nTest Set Performance Comparison:\")\n","print(f\"   * MLR Baseline: R2 = {mlr_test_r2:.6f}\")\n","print(f\"   * Stacking Ensemble: R2 = {test_r2:.6f}\")\n","print(f\"   * Final Improvement: +{test_r2 - mlr_test_r2:.6f}\")\n","\n","#Modelling: Exporting results\n","os.makedirs('../outputs/models', exist_ok=True)\n","os.makedirs('../outputs/tables', exist_ok=True)\n","\n","joblib.dump(final_stacking, '../outputs/models/07_final_stacking_model.pkl')\n","\n","test_results = pd.DataFrame({\n","    'Metric': ['R2', 'RMSE', 'MAE'],\n","    'Value': [test_r2, test_rmse, test_mae]\n","})\n","test_results.to_csv('../outputs/tables/07_test_results.csv', index=False)\n","\n","print(\"\\nFinal outputs serialized successfully\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"CDbaY2iMItOH","executionInfo":{"status":"ok","timestamp":1773843286502,"user_tz":-180,"elapsed":10563,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"fc2fbb47-0405-4fd5-ada4-cd7cfaa589af"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","==================================================\n","BUILDING FINAL STACKING MODEL\n","==================================================\n","\n","Level 1: Base Models\n","Final model trained on full training set\n","\n","==================================================\n","TEST SET EVALUATION\n","==================================================\n","\n","Final Test Performance:\n","   * R2:   0.976927\n","   * RMSE: 0.3073\n","   * MAE:  0.2449\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","Test Set Performance Comparison:\n","   * MLR Baseline: R2 = 0.974417\n","   * Stacking Ensemble: R2 = 0.976927\n","   * Final Improvement: +0.002509\n","\n","Final outputs serialized successfully\n"]}]},{"cell_type":"code","source":["#Data manipulation\n","import pandas as pd\n","import numpy as np\n","\n","#Visualization\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","\n","#Utilities\n","import os\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n"