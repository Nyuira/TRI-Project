est_dt.tree_\n","print(\"\\nTop-level splitting features and thresholds:\")\n","for i in range(min(5, tree_.node_count)):\n","    if tree_.feature[i] != -2:\n","        print(f\"Node {i}: {feature_names[tree_.feature[i]]} < {tree_.threshold[i]:.2f}\")\n","\n","#Finalizing cross-validation performance comparison across all baseline models\n","dt_cv = cross_validate(best_dt, X_train, y_train, cv=group_kfold, groups=groups_train, scoring={'r2': 'r2', 'neg_mse': 'neg_mean_squared_error'})\n","dt_r2, dt_rmse = np.mean(dt_cv['test_r2']), np.sqrt(np.mean(-dt_cv['test_neg_mse']))\n","\n","comparison_final = pd.DataFrame({\n","    'Model': ['Dummy', 'MLR', 'Lasso', 'Ridge', 'Decision Tree'],\n","    'R2': [-0.0863, 0.9699, 0.9699, 0.9699, dt_r2],\n","    'RMSE': [1.8578, 0.3086, 0.3086, 0.3086, dt_rmse]\n","})\n","\n","print(\"\\nFinal Baseline Models Comparison:\")\n","print(comparison_final.to_string(index=False, float_format=lambda x: f\"{x:.4f}\"))\n","\n","#Archiving feature importance, tree rules, and the model\n","dt_importance.to_csv('../outputs/tables/04_dt_importance.csv', index=False)\n","with open('../outputs/tables/04_dt_rules.txt', 'w') as f: f.write(tree_rules)\n","joblib.dump(best_dt, '../outputs/models/04_dt_model.pkl')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"_douR7CS_Q4j","executionInfo":{"status":"ok","timestamp":1773840773337,"user_tz":-180,"elapsed":6823,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"6fb97014-94a6-480a-c5b7-49bc185fc75a"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Hyperparameter grid combinations: 80\n","Fitting 5 folds for each of 80 candidates, totalling 400 fits\n","\n","Best parameters: {'max_depth': None, 'min_samples_leaf': 2, 'min_samples_split': 5}\n","Best CV R2: 0.7303\n","\n","Top 10 most important features (Decision Tree):\n","           Feature  Importance\n","          train_E7    0.293022\n","Digital_x_