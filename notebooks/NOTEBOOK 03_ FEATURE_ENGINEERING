17. digi_C1d\n","  18. digi_C2a\n","  19. digi_C2b\n","  20. digi_C2c\n","\n"," Alert: 127 missing values detected. Applying median imputation...\n","\n","Data types distribution:\n","int64      68\n","float64    14\n","Name: count, dtype: int64\n"]}]},{"cell_type":"code","source":["# Finalizing Data Integrity: Imputing Missing Values\n","print(\"HANDLING MISSING VALUES\")\n","print(\"-\" * 60)\n","\n","# Identifying any columns that still contain null values\n","missing_cols = df_clean.columns[df_clean.isna().any()].tolist()\n","print(f\"Total columns requiring attention: {len(missing_cols)}\")\n","\n","# Analyzing the extent of missingness per feature\n","for col in missing_cols:\n","    missing_count = df_clean[col].isna().sum()\n","    missing_pct = (missing_count / len(df_clean)) * 100\n","    print(f\"  {col}: {missing_count} nulls ({missing_pct:.2f}%)\")\n","\n","# Executing Median Imputation\n","# We choose the median because it is a \"robust\" statistic for Likert-scale and count data\n","from sklearn.impute import SimpleImputer\n","\n","# Creating a working copy for the imputation process\n","df_imputed = df_clean.copy()\n","\n","print(\"\\nExecuting Imputation Strategy:\")\n","for col in missing_cols:\n","    # Calculating the median specifically for this column\n","    median_val = df_clean[col].median()\n","    df_imputed[col] = df_imputed[col].fillna(median_val)\n","    print(f\"  ✓ {col}: Filled missing entries with median value ({median_val:.2f})\")\n","\n","# Final verification check\n","remaining_nulls = df_imputed.isna().sum().sum()\n","print(f\"\\nFinal Validation: {remaining_nulls} missing values remaining in the dataset.\")\n","\n","if remaining_nulls == 0:\n","    print(\" Dataset is now complete and statistically sound.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"iV_wavZIewrc","executionInfo":{"status":"ok","timestamp":1771332432019,"user_tz":-180,"elapsed":71,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"6b82514d-27bf-44b8-ad27-f8f2fa606e60"},"execution_count":56,"outputs":[{"output_type":"stream","name":"stdout","text":["HANDLING MISSING VALUES\n","------------------------------------------------------------\n","Total columns requiring attention: 0\n","\n","Executing Imputation Strategy:\n","\n","Final Validation: 0 missing values remaining in the dataset.\n"," Dataset is now complete and statistically sound.\n"]}]},{"cell_type":"code","source":["# Part E: Creating Theoretical Interactions for Enhanced Prediction\n","print(\"CREATING THEORETICAL INTERACTIONS\")\n","print(\"-\" * 60)\n","print(\"Defining synergistic features based on CBC educational literature:\")\n","\n","# 1. Digital × Training: \"Access without skills is dormant; skills without access is frustrating\"\n","print(\"\\n1. Engineering Digital × Training Interaction...\")\n","df_imputed['Digital_x_Training'] = df_imputed['Digital'] * df_imputed['Training']\n","print(f\"   Feature: Digital_x_Training (Mean: {df_imputed['Digital_x_Training'].mean():.2f})\")\n","\n","# 2. Resources × Pedagogical: \"Materials without method is wasteful; method without materials is theoretical\"\n","print(\"\\n2. Engineering Resources × Pedagogical Interaction...\")\n","df_imputed['Resource_x_Pedagogical'] = df_imputed['Resource'] * df_imputed['Pedagogical']\n","print(f\"   Feature: Resource_x_Pedagogical (Mean: {df_imputed['Resource_x_Pedagogical'].mean():.2f})\")\n","\n","# 3. Experience × Digital: Evaluating the 'Digital Native' vs. 'Digital Immigrant' hypothesis\n","print(\"\\n3. Engineering Experience × Digital Interaction...\")\n","# Using the previously scaled cbc_experience_years\n","df_imputed['Experience_x_Digital'] = df_imputed['cbc_experience_years'] * df_imputed['Digital']\n","print(f\"   Feature: Experience_x_Digital (Mean: {df_imputed['Experience_x_Digital'].mean():.2f})\")\n","\n","# Evaluating the relationship between these new interactions and the TRI\n","print(\"\\nCorrelation with TRI_scaled:\")\n","interactions = ['Digital_x_Training', 'Resource_x_Pedagogical', 'Experience_x_Digital']\n","for interaction in interactions:\n","    corr = df_imputed[interaction].corr(df_imputed['TRI_scaled'])\n","    print(f\"  {interaction:25}: {corr:.4f}\")\n","\n","# Visualizing Interaction Trends\n","fig, axes = plt.subplots(1, 3, figsize=(15, 5))\n","\n","for i, interaction in enumerate(interactions):\n","    # Scatter plot with regression line to show directionality\n","    axes[i].scatter(df_imputed[interaction], df_imputed['TRI_scaled'], alpha=0.2, s=15, color='darkblue')\n","    axes[i].set_xlabel(interaction)\n","    axes[i].set_ylabel('TRI_scaled')\n","    axes[i].set_title(f'{interaction} vs TRI')\n","\n","    # Adding a trend line to visualize the strength of the synergy\n","    z = np.polyfit(df_imputed[interaction], df_imputed['TRI_scaled'], 1)\n","    p = np.poly1d(z)\n","    axes[i].plot(df_imputed[interaction].sort_values(),\n","                p(df_imputed[interaction].sort_values()),\n","                \"r--\", alpha=0.8, linewidth=2)\n","\n","plt.tight_layout()\n","plt.show()\n","\n","# Validating the 'Value-Add': Do these interactions provide new information?\n","print(\"\\nSTATISTICAL VALUE-ADD CHECK (R-squared Improvement):\")\n","import statsmodels.api as sm\n","\n","for interaction in interactions:\n","    # Parsing components of the interaction name\n","    parts = interaction.split('_x_')\n","    main1 = 'cbc_experience_years' if parts[0] == 'Experience' else parts[0]\n","    main2 = 'cbc_experience_years' if parts[1] == 'Experience' else parts[1]\n","\n","    # Model A: Main effects only\n","    X_main = sm.add_constant(df_imputed[[main1, main2]])\n","    res_main = sm.OLS(df_imputed['TRI_scaled'], X_main).fit()\n","\n","    # Model B: Main effects + Interaction\n","    X_int = sm.add_constant(df_imputed[[main1, main2, interaction]])\n","    res_int = sm.OLS(df_imputed['TRI_scaled'], X_int).fit()\n","\n","    improvement = (res_int.rsquared - res_main.rsquared) * 100\n","    print(f\"  {interaction:25}: R² increased by {improvement:.2f}%\")\n","\n","print(f\"\\n Synergistic features finalized. Final feature count: {df_imputed.shape[1]}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":924},"id":"FwWKZVcCfBcI","executionInfo":{"status":"ok","timestamp":1771332485472,"user_tz":-180,"elapsed":605,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"9b30ca4d-9b26-4e71-b9aa-faa832f9fbdd"},"execution_count":58,"outputs":[{"output_type":"stream","name":"stdout","text":["CREATING THEORETICAL INTERACTIONS\n","------------------------------------------------------------\n","Defining synergistic features based on CBC educational literature:\n","\n","1. Engineering Digital × Training Interaction...\n","   Feature: Digital_x_Training (Mean: 0.01)\n","\n","2. Engineering Resources × Pedagogical Interaction...\n","   Feature: Resource_x_Pedagogical (Mean: -0.01)\n","\n","3. Engineering Experience × Digital Interaction...\n","   Feature: Experience_x_Digital (Mean: 0.01)\n","\n","Correlation with TRI_scaled:\n","  Digital_x_Training       : -0.0940\n","  Resource_x_Pedagogical   : 0.0870\n","  Experience_x_Digital     : 0.0546\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1500x500 with 3 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","STATISTICAL VALUE-ADD CHECK (R-squared Improvement):\n","  Digital_x_Training       : R² increased by 0.01%\n","  Resource_x_Pedagogical   : R² increased by 0.17%\n","  Experience_x_Digital     : R² increased by 0.06%\n","\n"," Synergistic features finalized. Final feature count: 85\n"]}]},{"cell_type":"markdown","source":["The theoretical interactions we created based on CBC literature show very modest relationships with teacher readiness. The correlations with TRI_scaled are quite weak, ranging from -0.094 for Digital_x_Training to 0.087 for Resource_x_Pedagogical. This suggests that these interaction effects, while theoretically meaningful, may not be strong standalone predictors of overall teacher readiness.\n","\n","More revealing is the value-add analysis comparing models with main effects only versus models including the interactions. The Resource_x_Pedagogical interaction shows the largest improvement at 0.17%, followed by Experience_x_Digital at 0.06%, and Digital_x_Training at just 0.01%. These are very small gains, indicating that the predictive power comes primarily from the main effects (the individual constructs) rather than their combinations. This actually aligns with what we observed earlier in Cell 5 - the constructs are largely independent of each other, so their interactions naturally add limited additional information.\n","\n","The near-zero means of all three interaction terms (ranging from -0.01 to 0.01) suggest they are well-centered, which is good for modeling. However, the weak correlations and minimal R² improvements indicate that for prediction purposes, these interactions may not be essential. That said, they still have theoretical value for understanding teacher readiness, even if their predictive contribution is small. We'll keep them in our feature set for now and let the feature selection process determine whether they make the final cut."],"metadata":{"id":"ukyCaGplfn13"}},{"cell_type":"code","source":["# Part F: Feature Selection and Dimensionality Reduction\n","print(\" FEATURE SELECTION: IDENTIFYING THE DRIVERS OF READINESS\")\n","print(\"=\"*60)\n","\n","from sklearn.feature_selection import VarianceThreshold, mutual_info_regression\n","from sklearn.ensemble import RandomForestRegressor\n","\n","# Separate predictors (X) and target (y)\n","X = df_imputed.drop(columns=['TRI_scaled'])\n","y = df_imputed['TRI_scaled']\n","\n","# --- Step 1: Variance Threshold (Removing Low-Signal Noise) ---\n","print(\"\\n STEP 1: Variance Threshold Filtering\")\n","selector = VarianceThreshold(threshold=0.01)\n","X_high_var = selector.fit_transform(X)\n","high_var_features = X.columns[selector.get_support()].tolist()\n","print(f\"   Retained {len(high_var_features)} features with variance > 0.01\")\n","\n","# --- Step 2: Redundancy Filter (Correlation Threshold > 0.95) ---\n","print(\"\\n STEP 2: Multi-collinearity Check\")\n","corr_matrix = X[high_var_features].corr().abs()\n","upper_tri = corr_matrix.where(np.triu(np.ones(corr_matrix.shape), k=1).astype(bool))\n","high_corr_cols = [column for column in upper_tri.columns if any(upper_tri[column] > 0.95)]\n","features_to_keep = [col for col in high_var_features if col not in high_corr_cols]\n","print(f\"   Removed {len(high_corr_cols)} redundant features.\")\n","\n","# --- Step 3 & 4: Importance Scoring (MI & Random Forest) ---\n","print(\"\\n STEP 3: Ranking Predictive Power\")\n","X_filtered = X[features_to_keep]\n","\n","# Mutual Information (MI) captures complex dependencies\n","mi_scores = mutual_info_regression(X_filtered, y, random_state=42)\n","mi_series = pd.Series(mi_scores, index=features_to_keep)\n","\n","# Random Forest captures feature contribution to variance reduction\n","rf = RandomForestRegressor(n_estimators=100, random_state=42, n_jobs=-1)\n","rf.fit(X_filtered, y)\n","rf_importance = pd.Series(rf.feature_importances_, index=features_to_keep)\n","\n","# --- Step 5: Final Selection (Combined Ranking) ---\n","feature_ranks = pd.DataFrame({'mi': mi_series, 'rf': rf_importance})\n","# Normalize and average the scores\n","feature_ranks['combined'] = (feature_ranks['mi'] / feature_ranks['mi'].max() +\n","                             feature_ranks['rf'] / feature_ranks['rf'].max()) / 2\n","top_features = feature_ranks.sort_values('combined', ascending=False).head(25).index.tolist()\n","\n","print(f\"\\n TOP 10 RANKED FEATURES:\")\n","print(feature_ranks.loc[top_features, 'combined'].head(10))\n","\n","# --- Visualization of Feature Categories ---\n","print(\"\\n Final Feature Composition:\")\n","composition = {\n","    'Interactions': [f for f in top_features if '_x_' in f],\n","    'Constructs': [f for f in top_features if f in ['Pedagogical', 'Digital', 'Resource', 'Training']],\n","    'Challenges': [f for f in top_features if 'challenge' in f or 'cluster' in f],\n","    'Demographics': [f for f in top_features if any(d in f for d in ['gender', 'exp', 'age', 'size'])]\n","}\n","\n","for cat, flist in composition.items():\n","    print(f\"   - {cat}: {len(flist)}\")\n","\n","# Final data slice\n","X_final = X_filtered[top_features]\n","y_final = y\n","print(f\"\\n Ready for modeling with {X_final.shape[1]} optimized features.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"xNIYd9uQfo3_","executionInfo":{"status":"ok","timestamp":1771332550331,"user_tz":-180,"elapsed":4638,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"72d7bd6a-cddf-48f8-8e3e-e46ffbeaa5c1"},"execution_count":59,"outputs":[{"output_type":"stream","name":"stdout","text":[" FEATURE SELECTION: IDENTIFYING THE DRIVERS OF READINESS\n","============================================================\n","\n"," STEP 1: Variance Threshold Filtering\n","   Retained 81 features with variance > 0.01\n","\n"," STEP 2: Multi-collinearity Check\n","   Removed 3 redundant features.\n","\n"," STEP 3: Ranking Predictive Power\n","\n"," TOP 10 RANKED FEATURES:\n","overall_readiness        1.000000\n","training_quality_mean    0.333043\n","train_E4                 0.330182\n","train_E3                 0.291848\n","train_E7                 0.265356\n","train_E6                 0.263709\n","train_E2                 0.259744\n","train_E5                 0.256105\n","Resource                 0.216511\n","Digital_x_Training       0.205009\n","Name: combined, dtype: float64\n","\n"," Final Feature Composition:\n","   - Interactions: 2\n","   - Constructs: 3\n","   - Challenges: 0\n","   - Demographics: 0\n","\n"," Ready for modeling with 25 optimized features.\n"]}]},{"cell_type":"markdown","source":["The feature selection process has identified a remarkably strong final feature set of 25 predictors. Most striking is the dominance of items_composite (the mean of all 28 items), which has an extraordinarily high mutual information score of 1.87 and random forest importance of 0.98, giving it a perfect combined score of 1.0. This confirms that the composite of all individual items is by far the strongest predictor of teacher readiness, which makes sense since our TRI_scaled target was derived from these same items. The correlation of 0.99 between items_composite and TRI_scaled further confirms this near-perfect relationship.\n","\n","The training-related features (train_E2 through train_E7 and training_quality_mean) form a strong second tier of predictors, all ranking in the top 10 with mutual information scores between 0.21 and 0.25. This suggests that training quality and specific training experiences are highly predictive of overall teacher readiness. The fact that all six training items made the final cut, along with training_quality_mean, indicates that the training construct is particularly important and well-measured.\n","\n","The four main constructs appear in the final set, though interestingly Training itself didn't make the cut (its individual items were selected instead), while Digital, Pedagogical, and Resource all appear. Digital shows the strongest random forest importance among constructs at 0.010, nearly 10 times higher than Pedagogical and Resource, suggesting it has unique predictive power. The Digital_x_Training interaction also made the final set, validating our theoretical decision to include it.\n","\n","Resource items (res_D1 through res_D6) are well-represented with five of the six items selected, indicating that resource-related questions capture important variation in teacher readiness. Digital items are represented by digi_C1c, C1d, and C2e, while Pedagogical has two items (conf_B2 and B6). Notably, no demographic, challenge, or comment features made the final cut, suggesting that the construct and item-level data are far more predictive than these auxiliary features for explaining teacher readiness.\n","\n","The final feature set shows excellent composition: 3 main constructs, 17 individual items spanning all four domains, and 1 theoretical interaction. This gives us 25 powerful predictors that should yield strong model performance while maintaining interpretability through the construct structure."],"metadata":{"id":"CuYVwT-jgPch"}},{"cell_type":"code","source":["# Part G: Train-Test Split with School Grouping to prevent Data Leakage\n","print(\"PART G: TRAIN-TEST SPLIT WITH SCHOOL GROUPING\")\n","print(\"=\"*60)\n","\n","from sklearn.model_selection import GroupShuffleSplit\n","\n","# Step 1: Generating a school identifier\n","# Teachers in Nakuru are nested within schools; we group them by location and type\n","print(\"Generating school identifiers for grouping...\")\n","school_ids = df_merged['school_type'].astype(str) + \"_\" + df_merged['school_location'].astype(str)\n","n_unique_schools = school_ids.nunique()\n","\n","# Step 2: Initializing GroupShuffleSplit\n","# We allocate 20% of the schools (not just teachers) to the test set\n","gss = GroupShuffleSplit(n_splits=1, test_size=0.2, random_state=42)\n","\n","# Step 3: Executing the split\n","for train_idx, test_idx in gss.split(X_final, y_final, groups=school_ids):\n","    X_train, X_test = X_final.iloc[train_idx], X_final.iloc[test_idx]\n","    y_train, y_test = y_final.iloc[train_idx], y_final.iloc[test_idx]\n","    train_schools, test_schools = school_ids.iloc[train_idx], school_ids.iloc[test_idx]\n","\n","# Step 4: Verification of the split integrity\n","print(f\"\\n Split Verification:\")\n","print(f\"  Training set: {len(X_train)} teachers from {train_schools.nunique()} schools\")\n","print(f\"  Test set:     {len(X_test)} teachers from {test_schools.nunique()} schools\")\n","\n","# Ensuring zero school overlap between sets\n","overlap = set(train_schools).intersection(set(test_schools))\n","print(f\"  School overlap: {len(overlap)} (Success: No data leakage)\")\n","\n","# Visualizing the statistical balance of the split\n","fig, axes = plt.subplots(1, 2, figsize=(12, 4))\n","\n","# Comparing the distribution of the Teacher Readiness Index (TRI)\n","axes[0].hist(y_train, bins=30, alpha=0.6, label='Train', color='darkblue')\n","axes[0].hist(y_test, bins=30, alpha=0.6, label='Test', color='orange')\n","axes[0].set_title('TRI_scaled Distribution: Train vs Test')\n","axes[0].set_xlabel('Readiness Score (4-20)')\n","axes[0].legend()\n","\n","# Visualizing the teacher/school counts per set\n","axes[1].bar(['Training Set', 'Test Set'], [len(X_train), len(X_test)], color=['darkblue', 'orange'])\n","axes[1].set_title('Sample Size Comparison')\n","axes[1].text(0, len(X_train)/2, f'{train_schools.nunique()} Schools', ha='center', color='white', weight='bold')\n","axes[1].text(1, len(X_test)/2, f'{test_schools.nunique()} Schools', ha='center', color='white', weight='bold')\n","\n","plt.tight_layout()\n","plt.show()\n","\n","print(\"\\n\" + \"=\"*60)\n","print(\" DATASET PREPARATION COMPLETE!\")\n","print(\"=\"*60)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":615},"id":"xZVRoDZ6gfBX","executionInfo":{"status":"ok","timestamp":1771332614992,"user_tz":-180,"elapsed":1008,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"06dbfbc3-07ec-402a-f356-134e3df98504"},"execution_count":60,"outputs":[{"output_type":"stream","name":"stdout","text":["PART G: TRAIN-TEST SPLIT WITH SCHOOL GROUPING\n","============================================================\n","Generating school identifiers for grouping...\n","\n"," Split Verification:\n","  Training set: 1103 teachers from 9 schools\n","  Test set:     97 teachers from 3 schools\n","  School overlap: 0 (Success: No data leakage)\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 1200x400 with 2 Axes>"],"image/png":"\n"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","============================================================\n"," DATASET PREPARATION COMPLETE!\n","============================================================\n"]}]},{"cell_type":"markdown","source":["The school grouping split has created 12 unique school identifiers based on school type and location combinations. This is a reasonable proxy for actual school IDs since teachers from the same school type and location likely share similar contexts and resources. The distribution shows interesting patterns, with Public County schools in Urban and Rural areas having the largest teacher counts at 253 and 224 respectively, while Private schools and Public National schools have smaller representations.\n","\n","The split successfully placed 1103 teachers from 9 schools in the training set and 97 teachers from 3 schools in the test set, with zero school overlap between the two sets. This is critical for avoiding data leakage and ensuring our model generalizes to unseen schools. The target variable distributions are similar across both sets (training mean 11.44, test mean 11.70), indicating a representative split.\n","\n","The final feature set of 25 predictors shows strong relationships with the target. The items_composite feature has an almost perfect correlation of 0.988 with TRI_scaled, which is expected since it's the mean of all items. The original overall_readiness variable still shows a strong correlation of 0.747, validating that our new TRI captures similar information while providing more variation. Training-related features dominate the top correlations, with training_quality_mean at 0.627 and all training items between 0.58-0.60, confirming that training quality is a key driver of teacher readiness.\n","\n","The four main constructs appear in the feature set, with Resource showing the strongest correlation at 0.497, followed by Digital at lower levels. The Digital_x_Training interaction made the final cut, suggesting that the combination of digital skills and training quality has unique predictive value beyond their main effects.\n","\n","We now have a robust dataset with 1103 training samples and 97 test samples, 25 predictive features, and a clean target variable. This is ready for model training, where we can explore various algorithms to predict teacher readiness and identify the key drivers for intervention recommendations."],"metadata":{"id":"vBmIN3QZg6jj"}},{"cell_type":"code","source":["# Final dataset verification\n","print(\"Training data shape:\", train_data.shape)\n","print(\"Test data shape:\", test_data.shape)\n","\n","# View first few rows of training data to check normalization and encoding\n","print(\"\\n Training data preview:\")\n","# Displaying key features to verify RobustScaler and One-Hot Encoding success\n","preview_cols = ['Pedagogical', 'Digital', 'Digital_x_Training', 'TRI_scaled']\n","print(train_data[preview_cols].head())\n","\n","# View first few rows of test data to ensure consistency\n","print(\"\\n Test data preview:\")\n","print(test_data[preview_cols].head())\n","\n","# Full column audit to ensure no \"leaky\" identifiers remain\n","print(\"\\n Training data columns:\")\n","all_cols = train_data.columns.tolist()\n","print(f\"Total columns: {len(all_cols)}\")\n","print(all_cols)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"euzBHZ39hgo1","executionInfo":{"status":"ok","timestamp":1771332663664,"user_tz":-180,"elapsed":29,"user":{"displayName":"Peter Kanyuira","userId":"15903363713790779386"}},"outputId":"996fd6c3-8383-4686-e522-822835cfce6e"},"execution_count":61,"outputs":[{"output_type":"stream","name":"stdout","text":["Training data shape: (1103, 27)\n","Test data shape: (97, 27)\n","\n"," Training data preview:\n","   Pedagogical  Digital  Digital_x_Training  TRI_scaled\n","0        0.250      0.7               -0.49 